// Managed by OpenTofu (server.tf). Local edits are overwritten on the next apply.
hostname "${hostname}"
rcon_password "${rcon_password}"
sv_password "${server_password}"

sv_allowupload 0
sv_allowdownload 1
mp_timelimit 30
log on
%{ if custom_cycle ~}
mapcyclefile "mapcycle_custom.txt"
%{ endif ~}
%{ if bot_quota > 0 ~}

// Keep the server at ${bot_quota} players with bots; each joining human replaces one.
tf_bot_quota ${bot_quota}
tf_bot_quota_mode fill
tf_bot_join_after_player 0
tf_bot_auto_vacate 1
tf_bot_difficulty ${bot_difficulty}
%{ endif ~}
